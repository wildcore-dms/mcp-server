# WildCore MCP Server

# WildCore connection
WILDCORE_URL=https://wildcore.example.com
# API key of a WildCore user (X-Auth-Key). Tools run with this user's permissions.
# May be left empty when the MCP server is in WildCore TRUSTED_HOST_NETWORK_LIST - then everything runs as the system user.
WILDCORE_TOKEN=
WILDCORE_VERIFY_SSL=true
WILDCORE_TIMEOUT=30

# Read-only mode: hide every tool that changes equipment or WildCore data
READ_ONLY_MODE=true

# Comma-separated tags to disable tools.
# Core groups: devices, interfaces, onts, logs, poller, switcher-core, api
# Component groups (WildCore component keys): olts, olts_control, onts_registration, macros, switches,
#   switches_control, routers, events, pinger, trapservice, console, fdb_history, search_device, diagnostic,
#   live_traffic, links, analytics, pon_boxes, oxidized
# Kinds: read-only, device-control, config
DISABLED_TAGS=

# Maximum tool result size in bytes - larger results are refused with a request to narrow the query
MAX_RESULT_BYTES=200000

# How often (seconds) the HTTP server reloads user permissions and enabled WildCore components
CAPABILITIES_TTL=300

# debug, info, notice, warning, error
LOG_LEVEL=warning

# Timezone of the WildCore server - log periods like "last 24 hours" are computed in it
TZ=UTC

# Tools returning credentials (Oxidized device configs, device access profiles, console session logs)
ENABLE_SECRETS=false

# OpenAPI spec of WildCore used by api_search / api_describe / api_read / api_call
# OPENAPI_URL=https://wildcore.example.com/swagger/openapi.yaml

# Expose only search_tools and call_tool instead of ~110 tool definitions (saves model context)
TOOL_SEARCH_ENABLED=false

# HTTP (RoadRunner). Not used by stdio.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
# Bearer token for MCP clients. Without it the endpoint is open to anyone who can reach it.
MCP_HTTP_BEARER_TOKEN=
# Allowed Host header values (DNS rebinding protection); behind a reverse proxy - the public host name
MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_HTTP_WORKERS=2
RATE_LIMIT_PER_MINUTE=120
