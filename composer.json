{
    "name": "meklis/wildcore-mcp",
    "description": "MCP server for WildCore DMS management",
    "type": "project",
    "license": "MIT",
    "keywords": ["wildcore", "mcp", "network", "olt", "onu", "automation"],
    "require": {
        "php": "~8.4.27 || ^8.5.12",
        "ext-json": "*",
        "ext-sockets": "*",
        "guzzlehttp/guzzle": "^7.16",
        "mcp/sdk": "^0.9",
        "nyholm/psr7": "^1.8",
        "spiral/roadrunner-http": "^4.2",
        "symfony/yaml": "^8.1",
        "vlucas/phpdotenv": "^5.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "WildcoreMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WildcoreMcp\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/wildcore-mcp"],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
